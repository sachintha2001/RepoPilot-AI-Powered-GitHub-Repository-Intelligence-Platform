# ==========================================
# RepoPilot Environment Configuration
# ==========================================

# Application & Security
APP_ENV=development
SECRET_KEY=repopilot-super-secret-jwt-signing-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Cache (PostgreSQL + pgvector & Redis)
DATABASE_URL=postgresql+asyncpg://repopilot:repopilot_pass@localhost:5432/repopilot_db
REDIS_URL=redis://localhost:6379/0

# GitHub Integration (OAuth & API)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Google Gemini API (AI & RAG Layer)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DEEP_MODEL=gemini-4-argon
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

